rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Lead rules
    match /leads/{leadId} {
      // Users can create their own leads
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.businessName is string
        && request.resource.data.email is string;
      
      // Users view their own, Admin views ALL
      allow list, read: if isSignedIn() && (
        resource.data.userId == request.auth.uid 
        || request.auth.token.email == 'customerservice.mme365@gmail.com'
        || request.auth.token.email_verified == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // System set only
    }
  }
}
