rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'customerservice.mme365@gmail.com' ||
        request.auth.token.email == 'marketingmanagementenp.365@gmail.com' ||
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    // Master Audits collection
    match /audits/{auditId} {
      allow create: if isSignedIn();
      allow list, read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Master Scouted Leads collection
    match /scouted_leads/{leadId} {
      allow create: if isSignedIn();
      allow list, read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Legacy leads rules (backward compatibility)
    match /leads/{leadId} {
      allow create: if isSignedIn();
      allow list, read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // User profiles & account controls
    match /users/{userId} {
      allow read, list: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
