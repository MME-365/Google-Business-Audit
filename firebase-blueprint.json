{
  "entities": {
    "Lead": {
      "title": "Audit Lead",
      "description": "Represents a business that has requested an audit.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who requested the audit." },
        "businessName": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "website": { "type": "string" },
        "overallScore": { "type": "number" },
        "auditBreakdown": { "type": "array" },
        "recommendations": { "type": "array" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "businessName", "location", "email", "phoneNumber", "timestamp", "overallScore"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account, subscription plan, and audit credits balance.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["free", "pro_49", "agency_249"] },
        "creditsBalance": { "type": "number" },
        "auditsUsedThisMonth": { "type": "number" },
        "auditsUsedThisYear": { "type": "number" },
        "unlockedAudits": { "type": "array" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "path": "/leads/{leadId}",
      "schema": "Lead",
      "description": "Collection of all audit leads."
    },
    "/users/{userId}": {
      "path": "/users/{userId}",
      "schema": "UserProfile",
      "description": "User subscription and profile data."
    }
  }
}
